[
  {
    "label": "CMake Configure (RelWithDebugInfo)",
    "command": "cmake",
    "args": [
      "-B",
      "build",
      "-G",
      "Ninja",
      "-DCMAKE_C_COMPILER=clang",
      "-DCMAKE_CXX_COMPILER=clang++",
      "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
      "-DCMAKE_BUILD_TYPE=RelWithDebInfo",
    ],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
  },
  {
    "label": "CMake: Build",
    "command": "cmake",
    "args": ["--build", "build"],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
  },
  {
    "label": "Cmake: Build and Run",
    "command": "cmd",
    "args": ["/c", "cmake --build build && ./build/RelWithDebInfo/archery-frontend.exe"],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
  },
]
